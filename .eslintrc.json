{
  "env": {"es6": true},
  "parserOptions": {"ecmaVersion": 2020, "sourceType": "module"},
  "globals": {"global": "readonly", "print": "readonly"},
  "rules": {
    "eqeqeq": "error",
    "no-undef": "error",
    "no-unused-vars": ["error", {"argsIgnorePattern": "^_"}],
    "semi": ["error", "always"]
  }
}
